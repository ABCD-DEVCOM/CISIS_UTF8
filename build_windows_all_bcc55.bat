@echo off
REM build_windows_all_bcc55.bat - GENERATED by tools/gen_bcc_all.py (do not edit by hand).
REM Builds ALL Windows variants of mx.exe and wxis.exe with Borland C++ 5.5 (and optionally the ABCD utilities),
REM one folder per variant:  dist\windows32\<variant>[-ansi]\
REM
REM *** NOT TESTED: it needs a Windows machine with BCC 5.5. If something fails, keep the output and compare it
REM     with the official BIREME .bat files in CISIS_UNI_Win\projects. ***
REM
REM Usage:  build_windows_all_bcc55.bat [utf8|ansi|both] [tools] [variant ...]
REM    utf8 (default) | ansi | both    character set of the engine (ANSI = the classic BIREME behaviour)
REM    tools                           also build the ABCD utilities (crunchif crunchmf retag ifkeys i2id id2i)
REM    variant ...                     subset, e.g.  ffi1660 isis   (default: all of them)
REM
REM Variants (same names as build_linux.sh; banner = PC32/W/[F]/[L]/M/<max record>/<LE1>/<LE2>/I):
REM    isis      M/32767/10/30           record <= 32,767 bytes, keys 30      (original CDS/ISIS limits)
REM    isis1660  M/32767/16/60           record <= 32,767 bytes, keys 60
REM    lind      L/M/32767/16/60         + inverted file with 32-bit postings (.ly1/.ly2/.iyp)
REM    lind512   L/M/32767/16/512        keys up to 512 bytes
REM    ffi       F/L/M/1048576/16/60     records up to 1 MiB, LIND inverted file
REM    ffi512    F/L/M/1048576/16/512    records up to 1 MiB, keys up to 512
REM    ffi1660   F/M/1048576/16/60       records up to 1 MiB, classic inverted file
REM    bigisis   F/M/1048576/16/256      records up to 1 MiB, classic inverted file, keys up to 256 (ABCD's large databases)
REM The "G" variants (files > 2 GB) only exist on Linux (build_all.sh); bigisis here is limited to 2 GiB files.
REM The banner of every Windows build carries "PC32" instead of "G/PC" (compiled with Borland, not gcc).
REM See _docs/LIMITS.md for the exact limits of each variant.
setlocal EnableDelayedExpansion
set ROOT=%~dp0
cd /d "!ROOT!"
if "%BCC%"=="" set BCC=C:\Borland\BCC55
if not exist "%BCC%\Bin\bcc32.exe" (
  echo bcc32.exe not found in %BCC%\Bin. Set the BCC variable or run find_compilers.ps1
  exit /b 1
)
set PATH=%BCC%\Bin;%PATH%

set MODE=utf8
set WITHTOOLS=0
set LIST=
:args
if "%~1"=="" goto argsdone
if /i "%~1"=="utf8"  (set MODE=utf8) else if /i "%~1"=="ansi" (set MODE=ansi) else if /i "%~1"=="both" (set MODE=both) else if /i "%~1"=="tools" (set WITHTOOLS=1) else (set LIST=!LIST! %~1)
shift
goto args
:argsdone
if "!LIST!"=="" set LIST=isis isis1660 lind lind512 ffi ffi512 ffi1660 bigisis

if not exist dist mkdir dist
if not exist dist\windows32 mkdir dist\windows32
set FAILED=0
set RESULT=
for %%V in (!LIST!) do call :variant %%V
echo.
echo ======================= SUMMARY =======================
for %%R in (!RESULT!) do echo   %%R
echo.
if "!FAILED!"=="0" (echo ALL OK: dist\windows32\) else (echo *** SOME BUILDS FAILED ***)
exit /b !FAILED!

:variant
set VAR=%1
set VFLAGS=

if /i "%VAR%"=="isis" set VFLAGS=-DCIFFI=0 -DLIND=0 -DISISXL=0 -DISISXL512=0 -DSUPERISIS=0
if /i "%VAR%"=="isis1660" set VFLAGS=-DCIFFI=0 -DLIND=0 -DISISXL=1 -DISISXL512=0 -DSUPERISIS=0
if /i "%VAR%"=="lind" set VFLAGS=-DCIFFI=0 -DLIND=1 -DISISXL=1 -DISISXL512=0 -DSUPERISIS=0
if /i "%VAR%"=="lind512" set VFLAGS=-DCIFFI=0 -DLIND=1 -DISISXL=1 -DISISXL512=1 -DSUPERISIS=0
if /i "%VAR%"=="ffi" set VFLAGS=-DCIFFI=1 -DLIND=1 -DISISXL=1 -DISISXL512=0 -DSUPERISIS=0
if /i "%VAR%"=="ffi512" set VFLAGS=-DCIFFI=1 -DLIND=1 -DISISXL=1 -DISISXL512=1 -DSUPERISIS=0
if /i "%VAR%"=="ffi1660" set VFLAGS=-DCIFFI=1 -DLIND=0 -DISISXL=1 -DISISXL512=0 -DSUPERISIS=0
if /i "%VAR%"=="bigisis" set VFLAGS=-DCIFFI=1 -DLIND=0 -DISISXL=1 -DISISXL512=0 -DSUPERISIS=1
if "!VFLAGS!"=="" (
  echo unknown variant: %VAR%   ^(valid: isis isis1660 lind lind512 ffi ffi512 ffi1660 bigisis^)
  set FAILED=1
  set RESULT=!RESULT! %VAR%:UNKNOWN
  goto :eof
)
if /i not "!MODE!"=="ansi" call :one %VAR% 1
if /i not "!MODE!"=="utf8" call :one %VAR% 0
goto :eof

REM ------------------------------------------------------------------------------------------------
REM :one <variant> <1=UTF-8 | 0=ANSI>
:one
set U=%2
set OUT=dist\windows32\%1
if "%U%"=="0" set OUT=dist\windows32\%1-ansi
if not exist %OUT% mkdir %OUT%
echo.
echo ################ %1  UTF8=%U%  ->  %OUT% ################
REM INCLOADX=1 makes CISIS read uctab=/actab= from the .par (needed for Russian, Greek, Hebrew...); on for UTF-8 only
set COMMON=-I"%BCC%\Include" -DUTF8=%U% -DINCLOADX=%U% !VFLAGS! -DLIND4=0 -DCIWTF=1 -DINCPROCX=1 -DINCPRECX=1

echo ===== mx =====
bcc32 %COMMON% -DGCC=0 -DPC=1 -DDOS32BITS=1 -DMSC=0 -DUNIX=0 -DWWWISIS=0 -DEXCFMCGI=0 -DEXCFMXML=0 -D_FILE_OFFSET_BITS=0 -D_LARGEFILE64_SOURCE=0 -DPCREADLINUX=0 -c mx.c mxaot.c ifloadao.c ciifl.c cisisx.c mxrun.c mxrel.c mxtxt.c mxbol.c cib71.c cib72.c cifm1.c cifm2.c cifm3.c cidbx.c cigiz.c cirec.c ciupd.c citrm.c ciupi.c ciiso.c ciutl.c cifst.c ciifu.c cicgi.c mys.c ciutf8.c
if errorlevel 1 goto onefail
bcc32 -L"%BCC%\Lib" -e%OUT%\mx.exe mx.obj mxaot.obj ifloadao.obj ciifl.obj cisisx.obj mxrun.obj mxrel.obj mxtxt.obj mxbol.obj cib71.obj cib72.obj cifm1.obj cifm2.obj cifm3.obj cidbx.obj cigiz.obj cirec.obj ciupd.obj citrm.obj ciupi.obj ciiso.obj ciutl.obj cifst.obj ciifu.obj cicgi.obj mys.obj ciutf8.obj
if errorlevel 1 goto onefail
del *.obj

echo ===== wxis =====
bcc32 %COMMON% -DWWWISIS=1 -c cidbx.c cirec.c cigiz.c citrm.c ciupd.c cifm1.c cifm2.c cifm3.c ciutl.c cib71.c cib72.c cifst.c ciifu.c ciupi.c ciifl.c cicgi.c ciiso.c mxaot.c mxrun.c mxrel.c mxtxt.c mxbol.c ifloadao.c mys.c ciutf8.c
if errorlevel 1 goto onefail
cd wxis_src
bcc32 %COMMON% -DWWWISIS=1 -c xis.c xis_exec.c xis_comp.c easyfc.c easyci.c arglist.c cgilist.c citpv.c freqlist.c hide.c hlfill.c cimsrt.c cixml.c
if errorlevel 1 goto onefail
cd ..
bcc32 -L"%BCC%\Lib" -e%OUT%\wxis.exe cidbx.obj cirec.obj cigiz.obj citrm.obj ciupd.obj cifm1.obj cifm2.obj cifm3.obj ciutl.obj cib71.obj cib72.obj cifst.obj ciifu.obj ciupi.obj ciifl.obj cicgi.obj ciiso.obj mxaot.obj mxrun.obj mxrel.obj mxtxt.obj mxbol.obj ifloadao.obj mys.obj wxis_src\xis.obj wxis_src\xis_exec.obj wxis_src\xis_comp.obj wxis_src\easyfc.obj wxis_src\easyci.obj wxis_src\arglist.obj wxis_src\cgilist.obj wxis_src\citpv.obj wxis_src\freqlist.obj wxis_src\hide.obj wxis_src\hlfill.obj wxis_src\cimsrt.obj wxis_src\cixml.obj ciutf8.obj
if errorlevel 1 goto onefail
del *.obj
del wxis_src\*.obj

if not "%WITHTOOLS%"=="1" goto onedone
REM ---- ABCD utilities (platform flags = the ones of mx, format flags = the ones of the BIREME .mak files)
set PLAT=-DGCC=0 -DPC=1 -DDOS32BITS=1 -DMSC=0 -DUNIX=0 -DUTF8=%U% -DINCLOADX=%U% !VFLAGS! -DLIND4=0 -DWWWISIS=0 -D_FILE_OFFSET_BITS=0 -D_LARGEFILE64_SOURCE=0 -DPCREADLINUX=0
set FMT=-DCIWTF=0 -DINCPROCX=0 -DINCPRECX=0 -DEXCFMCGI=1 -DEXCFMXML=1
set OPT=-I"%BCC%\Include" %PLAT% %FMT%
echo ===== crunchif =====
bcc32 %OPT% -c crunchif.c cidbx.c cigiz.c cirec.c ciupd.c ciutl.c citrm.c ciutf8.c
if errorlevel 1 goto onefail
bcc32 -L"%BCC%\Lib" -e%OUT%\crunchif.exe crunchif.obj cidbx.obj cigiz.obj cirec.obj ciupd.obj ciutl.obj citrm.obj ciutf8.obj
if errorlevel 1 goto onefail
del *.obj
echo ===== crunchmf =====
bcc32 %OPT% -c crunchmf.c cidbx.c cigiz.c cirec.c ciupd.c citrm.c ciutl.c ciutf8.c
if errorlevel 1 goto onefail
bcc32 -L"%BCC%\Lib" -e%OUT%\crunchmf.exe crunchmf.obj cidbx.obj cigiz.obj cirec.obj ciupd.obj citrm.obj ciutl.obj ciutf8.obj
if errorlevel 1 goto onefail
del *.obj
echo ===== retag =====
bcc32 %OPT% -c retag.c cidbx.c cigiz.c cirec.c ciupd.c citrm.c ciutl.c ciutf8.c
if errorlevel 1 goto onefail
bcc32 -L"%BCC%\Lib" -e%OUT%\retag.exe retag.obj cidbx.obj cigiz.obj cirec.obj ciupd.obj citrm.obj ciutl.obj ciutf8.obj
if errorlevel 1 goto onefail
del *.obj
echo ===== ifkeys =====
bcc32 %OPT% -c ifkeys.c cidbx.c citrm.c ciutf8.c
if errorlevel 1 goto onefail
bcc32 -L"%BCC%\Lib" -e%OUT%\ifkeys.exe ifkeys.obj cidbx.obj citrm.obj ciutf8.obj
if errorlevel 1 goto onefail
del *.obj
echo ===== i2id =====
bcc32 %OPT% -c i2id.c cidbx.c cigiz.c cirec.c ciupd.c citrm.c ciutl.c ciutf8.c
if errorlevel 1 goto onefail
bcc32 -L"%BCC%\Lib" -e%OUT%\i2id.exe i2id.obj cidbx.obj cigiz.obj cirec.obj ciupd.obj citrm.obj ciutl.obj ciutf8.obj
if errorlevel 1 goto onefail
del *.obj
echo ===== id2i =====
bcc32 %OPT% -c id2i.c cidbx.c cigiz.c cirec.c ciupd.c citrm.c ciutl.c ciutf8.c
if errorlevel 1 goto onefail
bcc32 -L"%BCC%\Lib" -e%OUT%\id2i.exe id2i.obj cidbx.obj cigiz.obj cirec.obj ciupd.obj citrm.obj ciutl.obj ciutf8.obj
if errorlevel 1 goto onefail
del *.obj
:onedone
del *.tds 2>nul
del %OUT%\*.tds 2>nul
set RESULT=!RESULT! %1:u%U%:OK
%OUT%\mx.exe 2>&1 | findstr /b /c:"XCore" /c:"CISIS"
goto :eof

:onefail
cd /d "!ROOT!"
del *.obj 2>nul
del wxis_src\*.obj 2>nul
echo.
echo *** FAILED: %1 (UTF8=%U%) - see the message above ***
set FAILED=1
set RESULT=!RESULT! %1:u%U%:FAILED
goto :eof
