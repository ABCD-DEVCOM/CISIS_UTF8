@echo off
REM build_windows_all_bcc55.bat - GENERATED by tools/gen_bcc_all.py (do not edit by hand).
REM Builds ALL Windows variants of mx.exe and wxis.exe with Borland C++ 5.5 (and optionally the ABCD utilities),
REM one folder per variant and character set:  dist\windows32\utf8\<variant>  and  dist\windows32\ansi\<variant>
REM (or, with "abcd" or no arguments, the folder layout ABCD ships: see below)
REM
REM *** NOT TESTED: it needs a Windows machine with BCC 5.5. If something fails, keep the output and compare it
REM     with the official BIREME .bat files in CISIS_UNI_Win\projects. ***
REM
REM Usage:  build_windows_all_bcc55.bat                  (no arguments = "abcd": what ABCD ships, in ABCD's folder layout)
REM         build_windows_all_bcc55.bat [abcd] [utf8|ansi|both] [tools|all] [variant ...]
REM    abcd                            build what ABCD ships, in ABCD's folder layout (see below). Implies "both" and "all"
REM    both (default) | utf8 | ansi    character set of the engine (ANSI = the classic BIREME behaviour; ABCD's administrative databases are ANSI)
REM    tools                           also build the six utilities ABCD's PHP code calls (crunchif crunchmf retag ifkeys i2id id2i)
REM    all                             also build EVERY program that has a .mak (38 in ANSI, 36 in UTF-8: mxgw and mz are not
REM                                    ported to UTF-8 yet; sizeof2 is a gcc-only diagnostic).
REM                                    A program that fails does not stop the build; the summary lists what was not built.
REM    variant ...                     subset, e.g.  ffi1660 isis   (default: all of them; with "abcd": isis1660 bigisis)
REM
REM "abcd" produces the same four folders as ABCD's cgi-bin (copy their contents over it):
REM    dist\abcd\windows32\ansi\            isis1660, ANSI    mx wxis + all the other programs, and wxis1660
REM    dist\abcd\windows32\ansi\bigisis\    bigisis,  ANSI    the same programs
REM    dist\abcd\windows32\utf8\            isis1660, UTF-8   the same, except mxgw and mz (not ported to UTF-8 yet)
REM    dist\abcd\windows32\utf8\bigisis\    bigisis,  UTF-8   as above, plus wxisnonuni, a copy of the ANSI bigisis wxis
REM wxis1660.exe and wxisnonuni.exe are plain copies, made because ABCD's Linux cgi-bin has files with those names.
REM
REM Variants (same names as build_linux.sh; banner = PC32/W/[F]/[L]/M/<max record>/<LE1>/<LE2>/I):
REM    isis      M/32767/10/30           record <= 32,767 bytes, keys 30      (original CDS/ISIS limits)
REM    isis1660  M/32767/16/60           record <= 32,767 bytes, keys 60
REM    lind      L/M/32767/16/60         + inverted file with 32-bit postings (.ly1/.ly2/.iyp)
REM    lind512   L/M/32767/16/512        keys up to 512 bytes
REM    ffi       F/L/M/1048576/16/60     records up to 1 MiB, LIND inverted file
REM    ffi512    F/L/M/1048576/16/512    records up to 1 MiB, keys up to 512
REM    ffi1660   F/M/1048576/16/60       records up to 1 MiB, classic inverted file
REM    bigisis   F/M/1048576/16/256      records up to 1 MiB, classic inverted file, keys up to 256 (ABCD's large databases)
REM The "G" variants (files > 2 GB) only exist on Linux (build_all.sh); bigisis here is limited to 2 GiB files.
REM The banner of every Windows build carries "PC32" instead of "G/PC" (compiled with Borland, not gcc).
REM See _docs/LIMITS.md for the exact limits of each variant.
setlocal EnableDelayedExpansion
set ROOT=%~dp0
cd /d "!ROOT!"
if "%BCC%"=="" set BCC=C:\Borland\BCC55
if not exist "%BCC%\Bin\bcc32.exe" (
  echo bcc32.exe not found in %BCC%\Bin. Set the BCC variable or run find_compilers.ps1
  exit /b 1
)
set PATH=%BCC%\Bin;%PATH%

set MODE=both
set WITHTOOLS=0
set ABCD=0
set WITHALL=0
set LIST=
REM no arguments at all = the ABCD set (what ABCD ships, in ABCD's folder layout)
if "%~1"=="" set ABCD=1
:args
if "%~1"=="" goto argsdone
if /i "%~1"=="utf8"  (set MODE=utf8) else if /i "%~1"=="ansi" (set MODE=ansi) else if /i "%~1"=="both" (set MODE=both) else if /i "%~1"=="tools" (set WITHTOOLS=1) else if /i "%~1"=="abcd" (set ABCD=1) else if /i "%~1"=="all" (set WITHALL=1) else (set LIST=!LIST! %~1)
shift
goto args
:argsdone
if "!ABCD!"=="1" set MODE=both
if "!ABCD!"=="1" set WITHALL=1
if "!WITHALL!"=="1" set WITHTOOLS=2
if "!LIST!"=="" if "!ABCD!"=="1" set LIST=isis1660 bigisis
if "!LIST!"=="" set LIST=isis isis1660 lind lind512 ffi ffi512 ffi1660 bigisis
