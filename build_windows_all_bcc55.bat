REM :link <program> <object> ...  - links %OUT%\<program>.exe if every object exists; a failure is recorded but never stops the build
:link
set LNAME=%~1
set LOBJS=
set LMISS=
:linkloop
shift
if "%~1"=="" goto linkgo
if not exist "%~1" set LMISS=!LMISS! %~1
set LOBJS=!LOBJS! %~1
goto linkloop
:linkgo
if not "!LMISS!"=="" goto linkmiss
bcc32 -L"%BCC%\Lib" -e%OUT%\!LNAME!.exe !LOBJS!
if errorlevel 1 goto linkfail
echo   !LNAME!: OK
goto :eof
:linkmiss
echo   !LNAME!: NOT BUILT, missing objects:!LMISS!
set PFAIL=!PFAIL! !LNAME!
set NOTBUILT=!NOTBUILT! !CURV!:u%U%/!LNAME!
goto :eof
:linkfail
echo   !LNAME!: LINK FAILED
set PFAIL=!PFAIL! !LNAME!
set NOTBUILT=!NOTBUILT! !CURV!:u%U%/!LNAME!
goto :eof

:onefail
cd /d "!ROOT!"
del *.obj 2>nul
del wxis_src\*.obj 2>nul
echo.
echo *** FAILED: %1 (UTF8=%U%) - see the message above ***
set FAILED=1
set RESULT=!RESULT! %1:u%U%:FAILED
goto :eof

REM :abcdout <variant> <1=UTF-8 | 0=ANSI>  - sets OUT to ABCD's layout: ansi\ utf8\ (isis1660) and ansi\bigisis\ utf8\bigisis\
:abcdout
set CS=utf8
if "%2"=="0" set CS=ansi
set OUT=dist\abcd\windows32\!CS!
if /i not "%1"=="isis1660" set OUT=!OUT!\%1
goto :eof

REM :abcdextras - the two extra file names that ABCD's Linux cgi-bin has (copies, not separate builds)
:abcdextras
if exist dist\abcd\windows32\ansi\wxis.exe copy /y dist\abcd\windows32\ansi\wxis.exe dist\abcd\windows32\ansi\wxis1660.exe >nul
if exist dist\abcd\windows32\ansi\bigisis\wxis.exe if exist dist\abcd\windows32\utf8\bigisis\wxis.exe copy /y dist\abcd\windows32\ansi\bigisis\wxis.exe dist\abcd\windows32\utf8\bigisis\wxisnonuni.exe >nul
goto :eof
