echo [build_windows_all_bcc55.bat, revision 6]
echo   variants: !LIST!
echo   character sets: !MODE!   programs: !PROGTXT!   ABCD folder layout: !ABCD!
if "!ABCD!"=="1" echo   output: dist\abcd\windows32\ansi, ansi\bigisis, utf8, utf8\bigisis
if not "!ABCD!"=="1" echo   output: dist\windows32\utf8\^<variant^> and dist\windows32\ansi\^<variant^>

if not exist dist mkdir dist
if not "!ABCD!"=="1" if not exist dist\windows32 mkdir dist\windows32
