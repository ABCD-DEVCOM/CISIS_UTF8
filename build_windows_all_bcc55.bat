if /i "%VAR%"=="lind" set VFLAGS=-DCIFFI=0 -DLIND=1 -DISISXL=1 -DISISXL512=0 -DSUPERISIS=0
if /i "%VAR%"=="lind512" set VFLAGS=-DCIFFI=0 -DLIND=1 -DISISXL=1 -DISISXL512=1 -DSUPERISIS=0
if /i "%VAR%"=="ffi" set VFLAGS=-DCIFFI=1 -DLIND=1 -DISISXL=1 -DISISXL512=0 -DSUPERISIS=0
if /i "%VAR%"=="ffi512" set VFLAGS=-DCIFFI=1 -DLIND=1 -DISISXL=1 -DISISXL512=1 -DSUPERISIS=0
