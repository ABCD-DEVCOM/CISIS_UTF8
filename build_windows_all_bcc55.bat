echo ======================= SUMMARY =======================
for %%R in (%RESULT%) do echo   %%R
for %%R in (%NOTBUILT%) do echo   NOT BUILT: %%R
echo.
if "!FAILED!"=="0" (if "!ABCD!"=="1" (echo ALL OK: dist\abcd\windows32\) else (echo ALL OK: dist\windows32\)) else (echo *** SOME BUILDS FAILED ***)
